# ===== MAU file cau hinh local — COPY thanh application-local.properties =====
# Moi thanh vien tao file application-local.properties tu file nay va dien gia tri that.
# File application-local.properties da duoc .gitignore — KHONG commit.
# File nay duoc nap qua spring.config.import trong application.properties.

# ----- Datasource (feed cho placeholder ${DB_URL}/${DB_USERNAME}/${DB_PASSWORD}) -----
DB_URL=jdbc:mysql://127.0.0.1:3306/ksh_db?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your_password_here

# ===== Google OAuth (BO COMMENT 3 dong duoi de bat dang nhap Google) =====
# Tao OAuth client ID tu https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
# Provider Google duoc Spring Boot tu dien qua CommonOAuth2Provider.GOOGLE.
# Khi cac key nay VANG MAT (van comment), OAuth auto-config tu back off -> app van chay.
#spring.security.oauth2.client.registration.google.client-id=your-client-id.apps.googleusercontent.com
#spring.security.oauth2.client.registration.google.client-secret=your-client-secret
#spring.security.oauth2.client.registration.google.scope=openid,profile,email

# ============================================================================
# SMTP — CAU HINH O ADMIN UI, KHONG O DAY
# ============================================================================
# Tu Sprint 2, SMTP credentials duoc luu o bang system_settings (key-value)
# va chinh sua qua /admin/settings/email khi dang nhap voi role ADMIN.
#
# Cac dong spring.mail.* BEN DUOI LA LEGACY va KHONG duoc doc tai runtime
# (MailService delegate cho DbConfiguredMailSender thay vi JavaMailSender bean).
# Khong can bo comment — chi luu lai cho lich su.
#
#spring.mail.host=sandbox.smtp.mailtrap.io
#spring.mail.port=2525
#spring.mail.username=your-mailtrap-username
#spring.mail.password=your-mailtrap-password
#spring.mail.properties.mail.smtp.auth=true
#spring.mail.properties.mail.smtp.starttls.enable=true

# ===== Base URL (dung trong link reset password) =====
# Prod: dat URL that, vi du https://ksh.edu.vn
#APP_BASE_URL=http://localhost:8080

# ===== Writing AI evaluator (Vertex OpenAI-compatible endpoint) =====
# VERTEX_ACCESS_TOKEN is a short-lived OAuth access token, not a durable API
# key. Obtain a newly rotated value in the process environment; never paste it
# into this file. Production refresh/ADC remains separate architecture work.
openai.api-key=${VERTEX_ACCESS_TOKEN:}
openai.base-url=${OPENAI_BASE_URL:https://aiplatform.googleapis.com/v1/projects/dii-cloudrun-demo-26-a7c9/locations/global/endpoints/openapi}
openai.evaluator-model=${OPENAI_EVALUATOR_MODEL:google/gemini-3.5-flash}
openai.connect-timeout=${OPENAI_CONNECT_TIMEOUT:5s}
openai.read-timeout=${OPENAI_READ_TIMEOUT:60s}

# Keep the observed 4096 budget until truncation is proven. These controls
# affect Writing evaluation only and are explicit provider capabilities.
openai.evaluator-max-output-tokens=${OPENAI_EVALUATOR_MAX_OUTPUT_TOKENS:4096}
openai.evaluator-structured-output-enabled=${OPENAI_EVALUATOR_STRUCTURED_OUTPUT_ENABLED:true}
openai.evaluator-reasoning-effort-enabled=${OPENAI_EVALUATOR_REASONING_EFFORT_ENABLED:false}
openai.evaluator-reasoning-effort=${OPENAI_EVALUATOR_REASONING_EFFORT:}

# ===== Lecturer Speaking prompt authoring (13C3; opt-in, provider-neutral) =====
# This is NOT the learner-response transcription configuration.
# Keep both operations disabled until a 13C3 adapter is configured and accepted.
#PRACTICE_PROMPT_AI_WORKER_ENABLED=false
#PRACTICE_PROMPT_AI_LEASE_DURATION=3m
#PRACTICE_PROMPT_STT_ENABLED=false
#PRACTICE_PROMPT_STT_PROVIDER=openai
#PRACTICE_PROMPT_STT_BASE_URL=https://api.openai.com/v1
#PRACTICE_PROMPT_STT_API_KEY=your-stt-key
#PRACTICE_PROMPT_STT_MODEL=your-stt-model
#PRACTICE_PROMPT_TTS_ENABLED=false
#PRACTICE_PROMPT_TTS_PROVIDER=openai
#PRACTICE_PROMPT_TTS_BASE_URL=https://api.openai.com/v1
#PRACTICE_PROMPT_TTS_API_KEY=your-tts-key
#PRACTICE_PROMPT_TTS_MODEL=your-tts-model
#PRACTICE_PROMPT_TTS_VOICE=default
# Cleanup performs no provider call. It only reconciles unreferenced private
# staging/artifacts after the local retention window.
#PRACTICE_PROMPT_ORPHAN_RETENTION=P30D
#PRACTICE_PROMPT_CLEANUP_WORKER_ENABLED=true
#PRACTICE_PROMPT_CLEANUP_INITIAL_DELAY=PT2M
#PRACTICE_PROMPT_CLEANUP_FIXED_DELAY=PT15M
