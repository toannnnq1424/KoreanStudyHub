{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksh.local/contracts/ksh-speaking-korean-alignment-v1.schema.json",
  "title": "KSH Korean direct-audio alignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "language", "evidence_mode", "alignment_status",
    "alignment_reason", "audio", "transcript", "engine", "provenance",
    "spans", "score_release"
  ],
  "properties": {
    "contract_version": { "const": "ksh-speaking-korean-alignment-v1" },
    "language": { "const": "ko-KR" },
    "evidence_mode": { "const": "DIRECT_AUDIO_ALIGNMENT" },
    "alignment_status": {
      "enum": ["COMPLETE", "PARTIAL_NON_SCORE", "UNAVAILABLE"]
    },
    "alignment_reason": { "type": "string", "minLength": 1 },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "audio_digest", "authorized_handle_fingerprint"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "audio_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authorized_handle_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "text_sha256", "offset_unit"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "offset_unit": { "const": "UTF16_CODE_UNIT" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_type", "provider", "model", "version", "capability_evidence_id"],
      "properties": {
        "component_type": {
          "enum": ["DEDICATED_FORCED_ALIGNER", "ASR_WORD_TIMESTAMPS"]
        },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "capability_evidence_id": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_request_fingerprint", "policy_bundle_id", "calibration_profile_id"],
      "properties": {
        "provider_request_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "policy_bundle_id": { "const": "KSH_SPEAKING_DIRECT_AUDIO_POLICY_BUNDLE_V1" },
        "calibration_profile_id": { "type": "string", "minLength": 1 }
      }
    },
    "spans": {
      "type": "array",
      "items": { "$ref": "#/$defs/alignmentSpan" }
    },
    "score_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "reason"],
      "properties": {
        "eligible": { "const": false },
        "reason": { "const": "ALIGNMENT_DARK_ONLY" }
      }
    }
  },
  "$defs": {
    "alignmentSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id", "level", "parent_span_id", "token_id", "surface_ko",
        "utf16_start", "utf16_end", "start_ms", "end_ms",
        "expected_pronunciation", "observed_pronunciation", "issue_code",
        "confidence", "evidence"
      ],
      "properties": {
        "span_id": { "type": "string", "minLength": 1 },
        "level": { "enum": ["EOJJEOL", "SYLLABLE", "JAMO", "PHONEME"] },
        "parent_span_id": { "type": ["string", "null"] },
        "token_id": { "type": "string", "minLength": 1 },
        "surface_ko": { "type": "string", "minLength": 1 },
        "utf16_start": { "type": "integer", "minimum": 0 },
        "utf16_end": { "type": "integer", "minimum": 1 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "expected_pronunciation": { "type": ["string", "null"] },
        "observed_pronunciation": { "type": ["string", "null"] },
        "issue_code": {
          "enum": [
            "NONE", "SUBSTITUTION", "OMISSION", "INSERTION", "DURATION",
            "PAUSE", "UNALIGNED", "LOW_CONFIDENCE"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "evidence_id"],
          "properties": {
            "source": {
              "enum": ["FORCED_ALIGNMENT", "ASR_WORD_TIMESTAMP", "ACOUSTIC_CLASSIFIER"]
            },
            "evidence_id": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
