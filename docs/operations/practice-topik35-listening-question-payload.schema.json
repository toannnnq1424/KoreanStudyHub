{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksh.local/schemas/practice-topik35-listening-question-payload-v1",
  "title": "Canonical TOPIK 35 Listening question payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "sourcePackageId", "bundleId", "capturedAt", "status", "skill", "sourceAuthority", "storagePolicy", "visualAssets", "questions", "qaBlockers", "remainingLoadBlockers", "validationSummary"],
  "properties": {
    "schemaVersion": {"const": "practice-topik35-listening-question-payload-v1"},
    "packageId": {"const": "topik35-v1-listening-question-payload-v1"},
    "sourcePackageId": {"const": "topik35-v1-listening-v1"},
    "bundleId": {"const": "topik35-v1"},
    "capturedAt": {"type": "string", "format": "date"},
    "status": {"const": "QUESTION_PAYLOAD_AND_VISUAL_QA_COMPLETE_LOAD_BLOCKED"},
    "skill": {"const": "LISTENING"},
    "sourceAuthority": {"$ref": "#/$defs/sourceAuthority"},
    "storagePolicy": {"$ref": "#/$defs/storagePolicy"},
    "visualAssets": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/visualAsset"}},
    "questions": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/question"}},
    "qaBlockers": {"type": "array", "items": {"$ref": "#/$defs/qaBlocker"}},
    "remainingLoadBlockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validationSummary": {"$ref": "#/$defs/validationSummary"}
  },
  "$defs": {
    "sourceAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["questionArtifactId", "questionArtifactSha256", "answerArtifactId", "answerArtifactSha256", "transcriptMaterializedByThisSlice", "audioTimingMaterializedByThisSlice"],
      "properties": {
        "questionArtifactId": {"const": "topik35-listening-writing-pdf"},
        "questionArtifactSha256": {"const": "cc21da6b877b27f0d7d3550c732282d610dadcea03a80842881f17eda3d51323"},
        "answerArtifactId": {"const": "topik35-answer-key-pdf"},
        "answerArtifactSha256": {"const": "60fb5fa5e5a211609d0d6e36bc1cacc490c34ff5a0009e6952e931f9a850d17b"},
        "transcriptMaterializedByThisSlice": {"const": false},
        "audioTimingMaterializedByThisSlice": {"const": false}
      }
    },
    "storagePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["logicalKeyOnly", "localDerivedAssetsIgnored", "objectStoreWrite", "bucketOrDeliveryUrlStored"],
      "properties": {
        "logicalKeyOnly": {"const": true}, "localDerivedAssetsIgnored": {"const": true},
        "objectStoreWrite": {"const": false}, "bucketOrDeliveryUrlStored": {"const": false}
      }
    },
    "cropPixels": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
      }
    },
    "visualSource": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "pdfPage", "printedPage", "renderDpi", "cropPixels"],
      "properties": {
        "artifactId": {"const": "topik35-listening-writing-pdf"},
        "pdfPage": {"type": "integer", "minimum": 3, "maximum": 4},
        "printedPage": {"type": "integer", "minimum": 1, "maximum": 2},
        "renderDpi": {"const": 200}, "cropPixels": {"$ref": "#/$defs/cropPixels"}
      }
    },
    "visualAsset": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "questionNumber", "optionId", "logicalKey", "mediaType", "sha256", "sizeBytes", "width", "height", "source", "qaStatus"],
      "properties": {
        "assetId": {"type": "string", "pattern": "^topik35-listening-q0[1-3]-opt-[1-4]$"},
        "questionNumber": {"type": "integer", "minimum": 1, "maximum": 3},
        "optionId": {"enum": ["opt_1", "opt_2", "opt_3", "opt_4"]},
        "logicalKey": {"type": "string", "pattern": "^practice-seed/topik35-v1/derived/page-image/[0-9a-f]{64}\\.png$"},
        "mediaType": {"const": "image/png"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "width": {"const": 480}, "height": {"type": "integer", "minimum": 300, "maximum": 402},
        "source": {"$ref": "#/$defs/visualSource"},
        "qaStatus": {"const": "VISUALLY_VERIFIED"}
      }
    },
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "imageReference"],
      "properties": {
        "id": {"enum": ["opt_1", "opt_2", "opt_3", "opt_4"]},
        "text": {"type": "string", "minLength": 1},
        "imageReference": {"oneOf": [
          {"type": "null"},
          {"type": "string", "pattern": "^practice-seed/topik35-v1/derived/page-image/[0-9a-f]{64}\\.png$"}
        ]}
      }
    },
    "questionContent": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "languageTag", "options", "blanks"],
      "properties": {
        "schemaVersion": {"const": "question-content-v3"},
        "languageTag": {"const": "ko"},
        "options": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/option"}},
        "blanks": {"type": "array", "maxItems": 0}
      }
    },
    "answerSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "questionType", "correctOptionIds", "correctValue", "blanks", "scoringPolicyCode"],
      "properties": {
        "schemaVersion": {"const": "answer-spec-v1"},
        "questionType": {"const": "SINGLE_CHOICE"},
        "correctOptionIds": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": ["opt_1", "opt_2", "opt_3", "opt_4"]}},
        "correctValue": {"type": "null"}, "blanks": {"type": "array", "maxItems": 0},
        "scoringPolicyCode": {"const": "ALL_OR_NOTHING"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["questionArtifactId", "questionPdfPage", "questionPrintedPage", "answerArtifactId", "answerPdfPage", "answerRowQuestion"],
      "properties": {
        "questionArtifactId": {"const": "topik35-listening-writing-pdf"},
        "questionPdfPage": {"type": "integer", "minimum": 3, "maximum": 15},
        "questionPrintedPage": {"type": "integer", "minimum": 1, "maximum": 13},
        "answerArtifactId": {"const": "topik35-answer-key-pdf"},
        "answerPdfPage": {"const": 1},
        "answerRowQuestion": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["questionNumber", "seedKey", "groupId", "prompt", "points", "questionType", "questionContent", "answerSpec", "provenance", "qaStatus", "ambiguityRecordId"],
      "properties": {
        "questionNumber": {"type": "integer", "minimum": 1, "maximum": 50},
        "seedKey": {"type": "string", "pattern": "^topik35-listening-q[0-9]{2}$"},
        "groupId": {"type": "string", "pattern": "^L[0-9]{2}_[0-9]{2}$"},
        "prompt": {"type": "string", "minLength": 1},
        "points": {"const": 2}, "questionType": {"const": "SINGLE_CHOICE"},
        "questionContent": {"$ref": "#/$defs/questionContent"},
        "answerSpec": {"$ref": "#/$defs/answerSpec"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "qaStatus": {"const": "VISUALLY_VERIFIED"},
        "ambiguityRecordId": {"type": "null"}
      }
    },
    "qaBlocker": {
      "type": "object", "additionalProperties": false,
      "required": ["questionNumber", "field", "reason"],
      "properties": {
        "questionNumber": {"type": "integer"}, "field": {"type": "string"}, "reason": {"type": "string"}
      }
    },
    "validationSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["questionCount", "optionCount", "textOptionCount", "imageOptionCount", "visualAssetCount", "answerCount", "ambiguityCount", "contentProjectionSha256", "payloadQaComplete", "loadReady"],
      "properties": {
        "questionCount": {"const": 50}, "optionCount": {"const": 200},
        "textOptionCount": {"const": 188}, "imageOptionCount": {"const": 12},
        "visualAssetCount": {"const": 12}, "answerCount": {"const": 50},
        "ambiguityCount": {"const": 0},
        "contentProjectionSha256": {"const": "52249b9398f8950e948b7d449d0d1391f493e9113aaffa78e9ab8818e604df1f"},
        "payloadQaComplete": {"const": true},
        "loadReady": {"const": false}
      }
    }
  }
}
